{
  "name": "hatsuboshi-backend",
  "version": "0.1.0",
  "description": "The backend server for Hatsuboshi App.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatsuboshi-app/backend.git"
  },
  "license": "MIT",
  "author": "HuzzNZ",
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "tsc --build && resolve-tspaths",
    "postbuild": "copyfiles -u 1 ./src/services/repository/local/data/*.json ./dist",
    "start": "node ./dist/app.js",
    "dev": "tsx watch --clear-screen=false src/app.ts",
    "dev:development": "tsx watch --env-file=.env.development --clear-screen=false src/app.ts",
    "dev:production": "tsx watch --env-file=.env.production --clear-screen=false src/app.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonfile": "^6.1.4",
    "@types/node": "^24.0.15",
    "copyfiles": "^2.4.1",
    "resolve-tspaths": "^0.8.23",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@hatsuboshi/types": "^1.1.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonfile": "^6.2.0",
    "mongodb": "^6.21.0"
  }
}
