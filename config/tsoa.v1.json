{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/controllers/v1/*.ts"],
  "spec": {
    "outputDirectory": "src/routes/v1",
    "basePath": "v1",
    "specVersion": 3.1
  },
  "routes": {
    "routesDir": "src/routes/v1"
  },
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}